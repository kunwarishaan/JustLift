# Copy to .env and fill these with your Supabase project's public settings.
# Vite embeds VITE_* values in the browser bundle. NEVER use a secret key or
# legacy service_role key here; only a publishable key (or legacy anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may instead set VITE_SUPABASE_ANON_KEY to their anon JWT.
# Run supabase/schema.sql in the project's SQL Editor before saving workouts.
# With email confirmation enabled, confirm the email and then sign in here.
